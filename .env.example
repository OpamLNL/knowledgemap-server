PORT=3002

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=graphedit
DB_SSL=false
DB_CA_PATH=./ca.pem
# Vercel: вставте CA Aiven одним рядком або з \n (нормалізується автоматично)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
# DB_SSL_REJECT_UNAUTHORIZED=false  # лише якщо з валідним CA все одно помилка SSL

JWT_SECRET=change-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ImgBB — збереження аватарів і зображень вузлів (https://api.imgbb.com/)
IMGBB_API_KEY=

# Vercel / production
# FRONTEND_URL=https://your-frontend.vercel.app
# FIREBASE_SERVICE_ACCOUNT=<base64 JSON service account>
